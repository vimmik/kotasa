# Supabase (Project Settings -> API keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Secret / service_role key — server only, never expose
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the app (used for the bill links in SMS and Google sign-in redirect)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Phone + PIN logins use an internal email on this domain (no emails are sent)
AUTH_EMAIL_DOMAIN=kotasa.local

# "off" hides the Google button until Google OAuth is set up in Supabase
NEXT_PUBLIC_GOOGLE_LOGIN=off

# Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=

# SMS provider: textlk (default) or notifylk
SMS_PROVIDER=textlk
# Text.lk (app.text.lk -> Developers -> API token). Use TextLKDemo until your own sender ID is approved.
TEXTLK_API_KEY=
TEXTLK_SENDER_ID=TextLKDemo
# Notify.lk (only when SMS_PROVIDER=notifylk) — NotifyDEMO as sender while testing
NOTIFY_USER_ID=
NOTIFY_API_KEY=
NOTIFY_SENDER_ID=NotifyDEMO
